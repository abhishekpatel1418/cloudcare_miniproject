# =========================================================================
# CloudCare Frontend Environment Configuration (AWS Connection Placeholders)
# Copy this file to .env and replace placeholder values with your real AWS IDs.
# NEVER commit your actual .env file with secrets to Git.
# =========================================================================

# AWS Region where your resources are deployed (e.g., us-east-1, ap-south-1)
VITE_AWS_REGION=us-east-1

# Amazon Cognito User Pool ID (from AWS Console -> Cognito -> User Pools)
# Example: us-east-1_aBcD1234
VITE_COGNITO_USER_POOL_ID=us-east-1_placeholder

# Amazon Cognito App Client ID (must have GENERATE_SECRET=false for web SPAs)
# Example: 7abcdefghijk1234567890
VITE_COGNITO_CLIENT_ID=placeholder_client_id_here

# Amazon API Gateway Base URL (from AWS Console -> API Gateway -> Stages)
# Example: https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/dev
VITE_API_BASE_URL=https://placeholder.execute-api.us-east-1.amazonaws.com/dev
